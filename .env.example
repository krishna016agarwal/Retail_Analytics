# ==============================================================================
# Environment Configuration - Intelligent Retail Analytics (SIH 179)
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS.
# DO NOT COMMIT THE REAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Central PostgreSQL Database Connection (Used by Central FastAPI Service on Render)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: Render provides this automatically as DATABASE_URL in the dashboard.
DATABASE_URL=postgresql://username:password@ep-example.oregon-postgres.render.com/retail_db

# Central Cloud API URL (Used by Local Edge Sync Client)
# Points to the deployed Render FastAPI Web Service URL.
CENTRAL_API_URL=https://retail-analytics-api.onrender.com

# CORS Configuration for Central API (Optional comma-separated list of origins)
# Default allows localhost web dashboards.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Edge Device Identification (Optional overrides for local analytics)
STORE_ID=store_001
DEVICE_ID=edge_device_01
